@rendermode InteractiveServer
@inject IJSRuntime JS
@inject LegelisteApp.Services.ChangelogService ChangelogService
@implements IDisposable

@if (isVisible)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 transition-opacity duration-300">
        <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl overflow-hidden border border-slate-200 transition-all duration-300 transform scale-100">
            <div class="bg-blue-600 px-6 py-8 text-center text-white relative">
                <div class="absolute top-4 right-4">
                     <button @onclick="Close" class="text-white/80 hover:text-white transition-colors">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white/20 backdrop-blur">
                    <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold">Was ist neu?</h2>
                <p class="text-blue-100">Version @CurrentAppVersion</p>
            </div>
            
            <div class="flex items-center justify-between px-6 pt-6 pb-2 border-b border-slate-100">
                <button @onclick="ShowOlder" disabled="@(currentVersionIndex == versionNumbers.Length - 1)" class="p-2 text-slate-400 hover:text-blue-600 disabled:opacity-30 disabled:hover:text-slate-400 transition-colors rounded-full hover:bg-slate-50" title="Ältere Version">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <h3 class="text-lg font-bold text-slate-800">Version @versionNumbers[currentVersionIndex]</h3>
                <button @onclick="ShowNewer" disabled="@(currentVersionIndex == 0)" class="p-2 text-slate-400 hover:text-blue-600 disabled:opacity-30 disabled:hover:text-slate-400 transition-colors rounded-full hover:bg-slate-50" title="Neuere Version">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>
            
            <div class="p-6 space-y-8 min-h-[300px]">
                @if (currentVersionIndex == 0)
                {
                    <!-- Version 1.3 -->
                    <div class="space-y-4 animate-in fade-in slide-in-from-right-4 duration-300">
                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Neuer Admin-Freigabe-Workflow</h4>
                                <p class="text-sm text-slate-500">Admins können unvollständige Einträge jetzt nicht nur freigeben, sondern über neue Buttons direkt selbst "Bearbeiten" oder an den Mitarbeiter "Ablehnen" (Zurückweisen).</p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Intelligenter Kalender</h4>
                                <p class="text-sm text-slate-500">Der Kalender zeigt nun viel präziser an, ob ein Tag noch komplett leer ist (Rot), als Entwurf in Bearbeitung ist (Gelb) oder vom Admin final genehmigt wurde (Grün).</p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-orange-50 text-orange-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Verbesserte Zeiteingaben</h4>
                                <p class="text-sm text-slate-500">Alle Uhrzeiten (wie Auslauf- oder Lichtzeiten) nutzen nun komfortable, native Zeitauswahl-Fenster, um Tippfehler zu vermeiden.</p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-purple-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Sichere Benutzerverwaltung</h4>
                                <p class="text-sm text-slate-500">Das versehentliche Löschen des Haupt-Admins ist nun blockiert und die Tabellenansicht wurde deutlich aufgeräumt.</p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Flexibles Speichern für Mitarbeiter</h4>
                                <p class="text-sm text-slate-500">Mitarbeiter können ihre Tageseinträge nun flexibel als Entwurf zwischenspeichern und erst am Ende des Tages, wenn alle Pflichtfelder gefüllt sind, zur finalen Freigabe einreichen.</p>
                            </div>
                        </div>
                    </div>
                }
                else if (currentVersionIndex == 1)
                {
                    <!-- Version 1.2 -->
                    <div class="space-y-4 animate-in fade-in slide-in-from-right-4 duration-300">
                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-orange-50 text-orange-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">Erweiterte Eingaben</h4>
                                <p class="text-sm text-slate-500">Zyklische Eingaben und die Möglichkeit zur Massen-Ausstallung wurden zum Formular hinzugefügt.</p>
                            </div>
                        </div>
                    </div>
                }
                else if (currentVersionIndex == 2)
                {
                    <!-- Version 1.1 -->
                    <div class="space-y-4 animate-in fade-in slide-in-from-right-4 duration-300">
                        <div class="flex gap-4">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-slate-900">System-Update</h4>
                                <p class="text-sm text-slate-500">Vollständige Umstellung der Datenbank auf MSSQL und Optimierungen für das neue Hosting.</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="p-6 pt-0 border-t border-slate-100 mt-0">
                <button @onclick="Close" class="w-full rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white shadow-lg hover:bg-slate-800 transition-all active:scale-[0.98]">
                    Verstanden
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string CurrentAppVersion = "1.3";
    private bool isVisible = false;

    private int currentVersionIndex = 0;
    private readonly string[] versionNumbers = { "1.3 (Aktuell)", "1.2", "1.1" };

    protected override void OnInitialized()
    {
        ChangelogService.OnShowRequested += Show;
    }

    public void Dispose()
    {
        ChangelogService.OnShowRequested -= Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                var hasSeen = await JS.InvokeAsync<string>("localStorage.getItem", "changelog_v13_confirmed");
                if (hasSeen != "true")
                {
                    await Task.Delay(500);
                    isVisible = true;
                    StateHasChanged();
                }
            }
            catch 
            {
                // Prerendering Schutz
            }
        }
    }

    public void Show()
    {
        isVisible = true;
        currentVersionIndex = 0;
        StateHasChanged();
    }

    private async Task Close()
    {
        isVisible = false;
        // Speichere, dass der Nutzer es gesehen hat
        await JS.InvokeVoidAsync("localStorage.setItem", "changelog_v13_confirmed", "true");
    }

    private void ShowNewer()
    {
        if (currentVersionIndex > 0)
        {
            currentVersionIndex--;
        }
    }

    private void ShowOlder()
    {
        if (currentVersionIndex < versionNumbers.Length - 1)
        {
            currentVersionIndex++;
        }
    }
}
