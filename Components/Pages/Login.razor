@page "/login"
@using LegelisteApp.Services
@using System.Security.Claims
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login - LegelisteApp</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-100 to-blue-50 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Logo & Title -->
        <div class="text-center mb-8">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-600 shadow-lg mb-4">
                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <ellipse cx="12" cy="12" rx="9" ry="11" stroke-width="2"/>
                    <ellipse cx="12" cy="10" rx="3" ry="4" stroke-width="2"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-slate-900">LegelisteApp</h1>
            <p class="text-sm text-slate-500 mt-1">Melden Sie sich mit Ihrem Konto an</p>
        </div>

        <!-- Card -->
        <div class="rounded-2xl border border-slate-200 bg-white shadow-xl overflow-hidden">
            <div class="p-8">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="mb-5 flex items-center gap-3 rounded-lg bg-red-50 border border-red-100 px-4 py-3">
                        <svg class="h-4 w-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <p class="text-sm text-red-700">@ErrorMessage</p>
                    </div>
                }

                <EditForm Model="LoginModel" OnValidSubmit="HandleLogin" FormName="LoginForm" method="post">
                    <DataAnnotationsValidator />
                    <div class="space-y-5">
                        <div class="space-y-1.5">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Benutzername</label>
                            <InputText id="username" 
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition-all focus:bg-white focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"
                                placeholder="Ihr Benutzername"
                                @bind-Value="LoginModel.Username" />
                            <ValidationMessage For="@(() => LoginModel.Username)" class="text-xs text-red-500" />
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Passwort</label>
                            <InputText id="password" type="password"
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition-all focus:bg-white focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"
                                placeholder="••••••••"
                                @bind-Value="LoginModel.Password" />
                            <ValidationMessage For="@(() => LoginModel.Password)" class="text-xs text-red-500" />
                        </div>

                        <button type="submit"
                            class="w-full rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 active:scale-[0.98] transition-all">
                            Anmelden
                        </button>
                    </div>
                </EditForm>
            </div>

            <!-- Hinweis für Admins -->
            <div class="border-t border-slate-100 bg-slate-50/70 px-8 py-5">
                <p class="text-xs text-slate-500 text-center">
                    Kein Konto? Bitte wenden Sie sich an Ihren Administrator.
                </p>
            </div>
        </div>

        <p class="text-center text-xs text-slate-400 mt-6">© @DateTime.Today.Year LegelisteApp</p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public LoginViewModel LoginModel { get; set; } = new();

    public string? ErrorMessage { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            RedirectBasedOnRole(HttpContext.User);
        }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        var result = await AuthService.LoginAsync(LoginModel.Username, LoginModel.Password);

        if (result)
        {
            var dbFactory = HttpContext?.RequestServices.GetRequiredService<Microsoft.EntityFrameworkCore.IDbContextFactory<LegelisteApp.Data.AppDbContext>>();
            if (dbFactory != null)
            {
                await using var context = await dbFactory.CreateDbContextAsync();
                var user = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                    context.Users, u => u.Username == LoginModel.Username);
                if (user != null)
                {
                    string target = "/";
                    if (user.Role == LegelisteApp.Data.Models.UserRole.Admin) target = "/admin";
                    else if (user.Role == LegelisteApp.Data.Models.UserRole.Praktikant) target = "/aktuelle-eintraege";
                    else target = "/datenerfassung";

                    NavigationManager.NavigateTo(target);
                    return;
                }
            }
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Ungültiger Benutzername oder Passwort.";
        }
    }

    private void RedirectBasedOnRole(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin")) NavigationManager.NavigateTo("/admin");
        else if (user.IsInRole("Praktikant")) NavigationManager.NavigateTo("/aktuelle-eintraege");
        else NavigationManager.NavigateTo("/datenerfassung");
    }

    public class LoginViewModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Benutzername ist erforderlich.")]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Passwort ist erforderlich.")]
        public string Password { get; set; } = "";
    }
}
