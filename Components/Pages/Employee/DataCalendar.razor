@page "/kalender"
@using LegelisteApp.Data
@using LegelisteApp.Data.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin, Mitarbeiter")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Vollständigkeits-Kalender - LegelisteApp</PageTitle>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="flex h-16 items-center justify-between px-6">
        <div>
            <h1 class="text-lg font-semibold text-slate-900">Operative Daten</h1>
            <p class="text-sm text-slate-500">Vollständigkeits-Check der Datenerfassung pro Stall</p>
        </div>
        <div class="flex items-center gap-4">
            <select @bind="selectedStallId" @bind:after="LoadCalendarData" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500/20">
                <option value="0">Stall wählen...</option>
                @foreach (var stall in stalls)
                {
                    <option value="@stall.Id">@stall.Name</option>
                }
            </select>
        </div>
    </div>
</header>

<div class="mx-auto max-w-4xl p-4 sm:p-6">
    @if (isLoading)
    {
        <div class="flex h-[50vh] items-center justify-center">
            <div class="flex flex-col items-center gap-3">
                <div class="h-8 w-8 animate-spin rounded-full border-4 border-slate-200 border-t-blue-600"></div>
                <p class="text-sm font-medium text-slate-500">Daten werden geladen...</p>
            </div>
        </div>
    }
    else
    {
    <div class="mb-6 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <button @onclick="PrevMonth" class="rounded-lg p-2 hover:bg-slate-100 transition-colors">
                <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <h2 class="text-xl font-bold text-slate-900 min-w-[150px] text-center">
                @currentMonth.ToString("MMMM yyyy")
            </h2>
            <button @onclick="NextMonth" class="rounded-lg p-2 hover:bg-slate-100 transition-colors">
                <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
        </div>
        <div class="flex gap-4 text-xs font-medium">
            <div class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-emerald-500"></span> Erfasst</div>
            <div class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-rose-500"></span> Fehlt</div>
            <div class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-slate-200"></span> Zukünftig</div>
        </div>
    </div>

    @if (selectedStallId == 0)
    {
        <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="mt-4 text-slate-500">Bitte wählen Sie oben einen Stall aus, um die Vollständigkeit zu prüfen.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-slate-200 shadow-sm">
            <div class="grid grid-cols-7 gap-px min-w-[600px] sm:min-w-0">
            @foreach (var day in new[] { "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So" })
            {
                <div class="bg-slate-50 py-3 text-center text-xs font-bold uppercase tracking-wider text-slate-500">@day</div>
            }

            @for (int i = 0; i < firstDayOffset; i++)
            {
                <div class="bg-white p-2 h-16 sm:h-32"></div>
            }

            @foreach (var date in days)
            {
                var isCompleted = completedDates.Contains(date.Date);
                var isFuture = date.Date > DateTime.Today;
                var isMissing = !isCompleted && !isFuture;

                <div class="relative bg-white p-2 h-16 sm:h-32 group transition-all @(isMissing ? "hover:bg-rose-50 cursor-pointer" : "")"
                     @onclick="() => OnDayClick(date)">
                    <span class="text-xs sm:text-sm font-semibold @(isFuture ? "text-slate-300" : "text-slate-600")">
                        @date.Day
                    </span>

                    <div class="absolute inset-x-1 bottom-1 sm:inset-x-2 sm:bottom-2">
                        @if (isCompleted)
                        {
                            <div class="flex items-center justify-center rounded-lg bg-emerald-50 py-1 sm:py-2 text-emerald-600">
                                <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            </div>
                        }
                        else if (isMissing)
                        {
                            <div class="flex flex-col items-center justify-center rounded-lg bg-rose-50 py-1 sm:py-2 text-rose-600 transition-transform group-hover:scale-105">
                                <svg class="h-4 w-4 sm:h-5 sm:w-5 sm:mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                <span class="hidden sm:inline text-[10px] font-bold uppercase">Nachtragen</span>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
        </div>
    }
    }
</div>

@code {
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int selectedStallId;
    private List<Stall> stalls = new();
    private HashSet<DateTime> completedDates = new();
    private List<DateTime> days = new();
    private int firstDayOffset;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();
        stalls = await context.Stalls.OrderBy(s => s.Name).ToListAsync();
        GenerateCalendarGrid();
        isLoading = false;
    }

    private async Task LoadCalendarData()
    {
        if (selectedStallId == 0) return;

        var start = currentMonth;
        var end = currentMonth.AddMonths(1);

        using var context = await DbFactory.CreateDbContextAsync();
        var entries = await context.DailyEntries
            .Where(e => e.StallId == selectedStallId && e.Date >= start && e.Date < end && (e.FutterKg > 0 || e.WasserLiter > 0 || e.Eier1Wahl > 0 || e.Verluste > 0 || e.Status == EntryStatus.Freigegeben))
            .Select(e => e.Date.Date)
            .ToListAsync();

        completedDates = new HashSet<DateTime>(entries);
        GenerateCalendarGrid();
    }

    private void GenerateCalendarGrid()
    {
        days.Clear();
        var daysInMonth = DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
        for (int d = 1; d <= daysInMonth; d++)
        {
            days.Add(new DateTime(currentMonth.Year, currentMonth.Month, d));
        }

        // Montag = 0, Sonntag = 6 für den ersten Tag des Monats berechnen
        var firstDayOfWeek = (int)currentMonth.DayOfWeek;
        firstDayOffset = (firstDayOfWeek == 0) ? 6 : firstDayOfWeek - 1;
    }

    private async Task PrevMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadCalendarData();
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadCalendarData();
    }

    private void OnDayClick(DateTime date)
    {
        if (date.Date <= DateTime.Today && !completedDates.Contains(date.Date))
        {
            Nav.NavigateTo($"/datenerfassung?PreDate={date.ToString("yyyy-MM-dd")}&PreStall={selectedStallId}");
        }
    }
}
