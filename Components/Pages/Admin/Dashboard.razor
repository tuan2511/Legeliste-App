@code {
    private int activeTab = 1;
    private int statsSubTab = 1; // 1=Gesamtbetrieb, 2=Stall-Detail
    private int currentUserId = 0;
    private bool isAdmin = false;

    private List<DailyEntry> pendingEntries = new();
    private List<DailyEntry> historyEntries = new();
    private List<DailyEntry> allHistoryEntries = new();
    private List<StallStatistic> stallStats = new();
    private List<Stall> allStalls = new();
    private string exportMessage = "";

    // Filter-State (Historie)
    private int filterStallId = 0;
    private DateTime filterFrom = DateTime.Today.AddDays(-30);
    private DateTime filterTo = DateTime.Today;

    // Statistik Stall-Detail
    private int detailStallId = 0;

    // Edit/Delete
    private DailyEntry? editingEntry = null;
    private bool showDeleteConfirm = false;
    private int deleteEntryId = 0;
    private bool isLoading = true;

    // Feed Delivery Modal
    private bool showFeedModal = false;
    private FeedDelivery newFeedDelivery = new() { Date = DateTime.Today, AmountKg = 0 };
    private string feedSaveMessage = "";

    // Futterbestand-Verlauf für das Diagramm
    private List<(DateTime Date, decimal BalanceKg)> inventoryHistory = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");

        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                currentUserId = id;
            }
        }

        await LoadDataAsync();
        isLoading = false;
    }

    private void SetTab(int tabIndex)
    {
        activeTab = tabIndex;
        if (tabIndex == 2)
        {
            // Kurze Verzögerung, damit das DOM für Chart.js bereit ist
            Task.Run(async () => {
                await Task.Delay(100);
                await UpdateChart();
            });
        }
    }

    private async Task LoadDataAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        allStalls = await context.Stalls.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

        // Offene Freigaben
        pendingEntries = await context.DailyEntries
            .Include(e => e.Stall)
            .Include(e => e.Creator)
            .Where(e => e.Status == EntryStatus.WartetAufFreigabe)
            .OrderBy(e => e.Date)
            .ToListAsync();

        // Alle freigegebenen Einträge für Berechnungen
        allHistoryEntries = await context.DailyEntries
            .Include(e => e.Stall)
            .Include(e => e.Creator)
            .Include(e => e.ApprovedBy)
            .Where(e => e.Status == EntryStatus.Freigegeben)
            .OrderByDescending(e => e.Date)
            .AsNoTracking()
            .ToListAsync();

        ApplyFilter();

        // Statistiken
        stallStats.Clear();
        foreach (var stall in allStalls)
        {
            var netChanges = allHistoryEntries
                .Where(e => e.StallId == stall.Id)
                .Sum(e => (e.Verluste ?? 0) - (e.ZugaengeTiere ?? 0));

            // Futterverbrauch: Zykluseinträge werden auf die Anzahl Tage verteilt
            var feedConsumed = allHistoryEntries
                .Where(e => e.StallId == stall.Id && e.Date >= stall.Einstallungsdatum)
                .Sum(e => e.FutterKg ?? 0);

            var feedDelivered = await context.FeedDeliveries
                .Where(fd => (fd.StallId == null || fd.StallId == stall.Id) && fd.Date >= stall.Einstallungsdatum)
                .SumAsync(fd => fd.AmountKg);

            stallStats.Add(new StallStatistic
            {
                StallName = stall.Name,
                Anfangsbestand = stall.AnfangsbestandTiere,
                AktuellLebend = stall.AnfangsbestandTiere - netChanges,
                Verluste = allHistoryEntries.Where(e => e.StallId == stall.Id).Sum(e => e.Verluste ?? 0),
                FeedBalanceKg = feedDelivered - feedConsumed
            });
        }

        // Futterbestand-Verlauf für Diagramm (letzte 30 Tage, global)
        inventoryHistory.Clear();
        var allDeliveries = await context.FeedDeliveries
            .OrderBy(fd => fd.Date)
            .ToListAsync();
        var totalDelivered = allDeliveries.Sum(fd => fd.AmountKg);
        var allConsumed = allHistoryEntries
            .Where(e => e.Status == EntryStatus.Freigegeben)
            .Sum(e => e.FutterKg ?? 0);
        decimal runningBalance = totalDelivered;
        for (int i = 29; i >= 0; i--)
        {
            var day = DateTime.Today.AddDays(-i);
            var dayDelivered = allDeliveries.Where(fd => fd.Date.Date == day.Date).Sum(fd => fd.AmountKg);
            var dayConsumed = allHistoryEntries
                .Where(e => e.Status == EntryStatus.Freigegeben && e.Date.Date == day.Date)
                .Sum(e => e.FutterKg ?? 0);
            runningBalance += dayDelivered - dayConsumed;
            inventoryHistory.Add((day, runningBalance));
        }
    }

    private async Task SetStatsSubTab(int tab)
    {
        statsSubTab = tab;
        if (tab == 1)
        {
            await Task.Delay(50);
            await UpdateChart();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && statsSubTab == 1)
        {
            await UpdateChart();
        }
    }

    private void ApplyFilter()
    {
        historyEntries = allHistoryEntries
            .Where(e =>
                (filterStallId == 0 || e.StallId == filterStallId) &&
                e.Date.Date >= filterFrom.Date &&
                e.Date.Date <= filterTo.Date)
            .ToList();
        StateHasChanged();
    }

    private void ResetFilter()
    {
        filterStallId = 0;
        filterFrom = DateTime.Today.AddDays(-30);
        filterTo = DateTime.Today;
        ApplyFilter();
    }

    private void StartEdit(DailyEntry entry)
    {
        // Erstelle eine Kopie damit Abbrechen kein Problem macht
        editingEntry = new DailyEntry
        {
            Id = entry.Id, Date = entry.Date, StallId = entry.StallId,
            Stall = entry.Stall, Verluste = entry.Verluste,
            ZugaengeTiere = entry.ZugaengeTiere,
            Eier1Wahl = entry.Eier1Wahl, Eier2Wahl = entry.Eier2Wahl,
            FutterKg = entry.FutterKg, WasserLiter = entry.WasserLiter,
            FutterlieferungKg = entry.FutterlieferungKg,
            Bemerkungen = entry.Bemerkungen,
            LichtVon = entry.LichtVon,
            LichtBis = entry.LichtBis,
            AuslaufzeitMorgensVon = entry.AuslaufzeitMorgensVon,
            AuslaufzeitMorgensBis = entry.AuslaufzeitMorgensBis,
            AuslaufzeitAbendsVon = entry.AuslaufzeitAbendsVon,
            AuslaufzeitAbendsBis = entry.AuslaufzeitAbendsBis,
            KontrollzeitenVon = entry.KontrollzeitenVon,
            KontrollzeitenBis = entry.KontrollzeitenBis,
            Eigewicht = entry.Eigewicht,
            Koerpergewicht = entry.Koerpergewicht
        };
    }

    private async Task SaveEdit()
    {
        if (editingEntry == null) return;
        using var context = await DbFactory.CreateDbContextAsync();
        var dbEntry = await context.DailyEntries.FindAsync(editingEntry.Id);
        if (dbEntry != null)
        {
            dbEntry.Verluste = editingEntry.Verluste;
            dbEntry.Eier1Wahl = editingEntry.Eier1Wahl;
            dbEntry.Eier2Wahl = editingEntry.Eier2Wahl;
            dbEntry.FutterKg = editingEntry.FutterKg;
            dbEntry.WasserLiter = editingEntry.WasserLiter;
            dbEntry.FutterlieferungKg = editingEntry.FutterlieferungKg;
            dbEntry.ZugaengeTiere = editingEntry.ZugaengeTiere;
            dbEntry.Bemerkungen = editingEntry.Bemerkungen;
            dbEntry.LichtVon = editingEntry.LichtVon;
            dbEntry.LichtBis = editingEntry.LichtBis;
            dbEntry.AuslaufzeitMorgensVon = editingEntry.AuslaufzeitMorgensVon;
            dbEntry.AuslaufzeitMorgensBis = editingEntry.AuslaufzeitMorgensBis;
            dbEntry.AuslaufzeitAbendsVon = editingEntry.AuslaufzeitAbendsVon;
            dbEntry.AuslaufzeitAbendsBis = editingEntry.AuslaufzeitAbendsBis;
            dbEntry.KontrollzeitenVon = editingEntry.KontrollzeitenVon;
            dbEntry.KontrollzeitenBis = editingEntry.KontrollzeitenBis;
            dbEntry.Eigewicht = editingEntry.Eigewicht;
            dbEntry.Koerpergewicht = editingEntry.Koerpergewicht;
            await context.SaveChangesAsync();
        }
        editingEntry = null;
        await LoadDataAsync();
    }

    private void AskDelete(int id)
    {
        deleteEntryId = id;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;
        using var context = await DbFactory.CreateDbContextAsync();
        var entry = await context.DailyEntries.FindAsync(deleteEntryId);
        if (entry != null)
        {
            context.DailyEntries.Remove(entry);
            await context.SaveChangesAsync();
        }
        await LoadDataAsync();
    }

    private async Task UpdateChart()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var sevenDaysAgo = DateTime.Today.AddDays(-7);
        
        var recentEntries = await context.DailyEntries
            .Where(e => e.Status == EntryStatus.Freigegeben && e.Date >= sevenDaysAgo)
            .OrderBy(e => e.Date)
            .ToListAsync();

        // Gruppierung nach Datum (Summe über alle Ställe pro Tag)
        var groupedData = recentEntries
            .GroupBy(e => e.Date.Date)
            .Select(g => new {
                Date = g.Key.ToShortDateString(),
                Food = g.Sum(e => e.FutterKg),
                Water = g.Sum(e => e.WasserLiter)
            })
            .ToList();

        var labels = groupedData.Select(d => d.Date).ToArray();
        var foodValues = groupedData.Select(d => d.Food).ToArray();
        var waterValues = groupedData.Select(d => d.Water).ToArray();

        await JS.InvokeVoidAsync("renderConsumptionChart", "consumptionChart", labels, foodValues, waterValues);
    }

    private async Task ApproveEntry(DailyEntry entry)
    {
        if (currentUserId == 0) return;

        if (!entry.Verluste.HasValue || !entry.Eier1Wahl.HasValue || !entry.FutterKg.HasValue || !entry.WasserLiter.HasValue)
        {
            await JS.InvokeVoidAsync("alert", "Fehler: Verluste, Eier 1. Wahl, Futterverbrauch und Wasserverbrauch sind Pflichtfelder. Bitte füllen Sie alle aus, bevor Sie freigeben!");
            return;
        }

        using var context = await DbFactory.CreateDbContextAsync();
        
        // Da 'entry' aus einer vorherigen Context-Instanz stammt, müssen wir es attachen oder neu laden
        var dbEntry = await context.DailyEntries.FindAsync(entry.Id);
        if (dbEntry != null)
        {
            // Übernehme evtl. vorgenommene Änderungen durch den Admin aus dem UI-Binding
            dbEntry.Verluste = entry.Verluste;
            dbEntry.ZugaengeTiere = entry.ZugaengeTiere;
            dbEntry.FutterKg = entry.FutterKg;
            dbEntry.WasserLiter = entry.WasserLiter;
            dbEntry.Eier1Wahl = entry.Eier1Wahl;
            dbEntry.Eier2Wahl = entry.Eier2Wahl;
            dbEntry.FutterlieferungKg = entry.FutterlieferungKg;

            // Status ändern & Freigeber setzen
            dbEntry.Status = EntryStatus.Freigegeben;
            dbEntry.ApprovedById = currentUserId;

            await context.SaveChangesAsync();

            // Nach dem Speichern Daten neu laden, um die UI (Tabs) zu aktualisieren
            await LoadDataAsync();
        }
    }

    private async Task RejectEntryAsync(DailyEntry entry)
    {
        if (currentUserId == 0) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var dbEntry = await context.DailyEntries.FindAsync(entry.Id);
        if (dbEntry != null)
        {
            dbEntry.Status = EntryStatus.Entwurf;
            dbEntry.ApprovedById = null;
            await context.SaveChangesAsync();
            await LoadDataAsync();
        }
    }

    private async Task SaveFeedDelivery()
    {
        if (newFeedDelivery.AmountKg <= 0)
        {
            feedSaveMessage = "Menge muss größer als 0 sein.";
            return;
        }
        
        using var context = await DbFactory.CreateDbContextAsync();
        context.FeedDeliveries.Add(newFeedDelivery);
        await context.SaveChangesAsync();
        
        showFeedModal = false;
        await LoadDataAsync(); // Refresh stats
    }

    private void OpenFeedDeliveryModal(int stallId)
    {
        newFeedDelivery = new FeedDelivery { StallId = stallId > 0 ? stallId : null, Date = DateTime.Today, AmountKg = 0 };
        feedSaveMessage = "";
        showFeedModal = true;
    }

    private async Task ExportLast7Days()
    {
        exportMessage = "";
        
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var entriesToExport = await context.DailyEntries
                .Include(e => e.Stall)
                .Where(e => e.Status == EntryStatus.Freigegeben)
                .OrderBy(e => e.StallId)
                .ThenBy(e => e.Date)
                .ToListAsync();

            if (entriesToExport.Count == 0)
            {
                exportMessage = "Keine freigegebenen Einträge vorhanden.";
                return;
            }

            var excelData = await ExportService.GenerateExcelAsync(entriesToExport);
            
            using var stream = new MemoryStream(excelData);
            using var streamRef = new DotNetStreamReference(stream);

            var kw = System.Globalization.ISOWeek.GetWeekOfYear(DateTime.Today);
            var year = DateTime.Today.Year;
            var fileName = $"Legeliste_Novogen_{year}_KW{kw}.xlsx";

            // JS-Interop aufrufen
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            exportMessage = $"Fehler beim Export: {ex.Message}";
        }
    }

    private decimal GetLastBalance() =>
        inventoryHistory.Count > 0 ? inventoryHistory.Last().BalanceKg : 0;

    private string GetBalanceColor()
    {
        var bal = GetLastBalance();
        return bal < 1000 ? "#ef4444" : (bal < 3000 ? "#f59e0b" : "#10b981");
    }

    private string BuildInventoryChartSvg()
    {
        const int svgW = 800, svgH = 200, padL = 60, padR = 20, padT = 15, padB = 30;
        int chartW = svgW - padL - padR;
        int chartH = svgH - padT - padB;

        // 1. Daten zwingend chronologisch sortieren
        var sortedHistory = inventoryHistory.OrderBy(x => x.Date).ToList();

        double maxBal = Math.Max((double)sortedHistory.Max(h => h.BalanceKg), 1);
        double minBal = Math.Min((double)sortedHistory.Min(h => h.BalanceKg), 0);
        double range = maxBal - minBal;
        if (range == 0) range = 1;

        var n = sortedHistory.Count;
        string color = sortedHistory.Last().BalanceKg < 1000 ? "#ef4444"
                     : sortedHistory.Last().BalanceKg < 3000 ? "#f59e0b" : "#10b981";

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {svgW} {svgH}\" style=\"width:100%;min-width:320px;height:200px;\">");

        // Gitter + Y-Labels
        for (int gi = 0; gi <= 4; gi++)
        {
            double gy = padT + gi * (double)chartH / 4;
            double gVal = maxBal - gi * range / 4;
            sb.Append($"<line x1=\"{padL}\" y1=\"{gy:F0}\" x2=\"{svgW - padR}\" y2=\"{gy:F0}\" stroke=\"#f1f5f9\" stroke-width=\"1\"/>");
            sb.Append($"<text x=\"{padL - 6}\" y=\"{gy + 4:F0}\" text-anchor=\"end\" font-size=\"9\" fill=\"#94a3b8\">{gVal:N0} kg</text>");
        }

        // X-Labels
        int labelStep = Math.Max(1, n / 6);
        for (int li = 0; li < n; li += labelStep)
        {
            double lx = padL + (n > 1 ? li * (double)chartW / (n - 1) : chartW / 2.0);
            sb.Append($"<text x=\"{lx:F0}\" y=\"{svgH}\" text-anchor=\"middle\" font-size=\"8\" fill=\"#94a3b8\">{sortedHistory[li].Date.ToString("dd.MM.")}</text>");
        }

        // Punkte berechnen
        var pts = sortedHistory.Select((h, i) => {
            double x = padL + (n > 1 ? i * (double)chartW / (n - 1) : chartW / 2.0);
            double y = padT + chartH - ((double)h.BalanceKg - minBal) / range * chartH;
            return (x, y);
        }).ToList();

        // Füllfläche
        double baseY = padT + chartH - (Math.Max(0, -minBal) / range * chartH);
        if (pts.Any())
        {
            double firstX = pts.First().x;
            double lastX = pts.Last().x;
            var pathPts = string.Join(" ", pts.Select(p => $"L {p.x:F1},{p.y:F1}"));
            
            // 2. Pfad korrekt schließen: Start bei firstX/baseY, alle Punkte, dann runter zu lastX/baseY, und Z (zurück zum Start)
            sb.Append($"<path d=\"M {firstX:F1},{baseY:F0} {pathPts} L {lastX:F1},{baseY:F0} Z\" fill=\"{color}\" opacity=\"0.08\"/>");
        }

        // Linie
        var polyline = string.Join(" ", pts.Select(p => $"{p.x:F1},{p.y:F1}"));
        sb.Append($"<polyline points=\"{polyline}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>");

        // Endpunkt
        if (pts.Any())
            sb.Append($"<circle cx=\"{pts.Last().x:F1}\" cy=\"{pts.Last().y:F1}\" r=\"4\" fill=\"{color}\"/>");

        // Nulllinie (falls negativ)
        if (minBal < 0)
        {
            double zeroY = padT + chartH - (0 - minBal) / range * chartH;
            sb.Append($"<line x1=\"{padL}\" y1=\"{zeroY:F0}\" x2=\"{svgW - padR}\" y2=\"{zeroY:F0}\" stroke=\"#ef4444\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

