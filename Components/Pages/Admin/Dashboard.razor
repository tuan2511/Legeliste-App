@page "/admin"
@using LegelisteApp.Data
@using LegelisteApp.Data.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject LegelisteApp.Services.ExportService ExportService
@inject LegelisteApp.Services.FlockCalculationService CalcService
@inject LegelisteApp.Services.PerformanceNormService NormService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Dashboard - LegelisteApp</PageTitle>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="flex h-16 items-center justify-between px-6">
        <div>
            <h1 class="text-lg font-semibold text-slate-900">Dashboard</h1>
            <p class="text-sm text-slate-500">Übersicht aller Stalldaten</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-500">Letzte Aktualisierung: @DateTime.Now.ToString("HH:mm") Uhr</span>
        </div>
    </div>
</header>

<div class="space-y-6 p-6">
    @if (isLoading)
    {
        <div class="flex h-[50vh] items-center justify-center">
            <div class="flex flex-col items-center gap-3">
                <div class="h-8 w-8 animate-spin rounded-full border-4 border-slate-200 border-t-blue-600"></div>
                <p class="text-sm font-medium text-slate-500">Daten werden geladen...</p>
            </div>
        </div>
    }
    else
    {
    <!-- View Switcher (Subtabs) -->
    <div class="flex gap-2 p-1 bg-slate-100 rounded-lg w-fit">
        <button class="px-4 py-1.5 text-sm font-medium rounded-md transition-all @(statsSubTab == 1 ? "bg-white shadow-sm text-slate-900" : "text-slate-500 hover:text-slate-700")" @onclick="() => SetStatsSubTab(1)">
            🏢 Gesamtbetrieb
        </button>
        <button class="px-4 py-1.5 text-sm font-medium rounded-md transition-all @(statsSubTab == 2 ? "bg-white shadow-sm text-slate-900" : "text-slate-500 hover:text-slate-700")" @onclick="() => SetStatsSubTab(2)">
            🏠 Stall-Detail
        </button>
    </div>

    @if (statsSubTab == 1)
    {
        var totalBestand = stallStats.Sum(s => s.AktuellLebend);
        var totalVerluste = stallStats.Sum(s => s.Verluste);
        var todayEggs = allHistoryEntries.Where(e => e.Date.Date == DateTime.Today).Sum(e => (e.Eier1Wahl ?? 0) + (e.Eier2Wahl ?? 0));
        var avgLay = stallStats.Count > 0 && totalBestand > 0 ? CalcService.CalculateLayingPerformance(todayEggs, totalBestand) : 0m;
        var verlustPctTotal = stallStats.Sum(s => s.Anfangsbestand) > 0 ? (double)totalVerluste / stallStats.Sum(s => s.Anfangsbestand) * 100 : 0;

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between pb-2">
                    <h3 class="text-sm font-medium text-slate-500">Gesamtbestand</h3>
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m0 0V19a2 2 0 01-2 2H5a2 2 0 01-2-2v-5"/></svg>
                </div>
                <div class="text-2xl font-bold tracking-tight text-slate-900">@totalBestand.ToString("N0")</div>
            </div>

            <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between pb-2">
                    <h3 class="text-sm font-medium text-slate-500">Gesamtverluste</h3>
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <div class="text-2xl font-bold tracking-tight @(verlustPctTotal > 1 ? "text-red-600" : "text-slate-900")">@totalVerluste</div>
                <div class="mt-1 flex items-center gap-2">
                    <span class="inline-flex items-center gap-1 rounded-full px-1.5 py-0.5 text-xs font-medium @(verlustPctTotal > 1 ? "bg-red-100 text-red-700" : "bg-slate-100 text-slate-700")">@verlustPctTotal.ToString("0.##")%</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between pb-2">
                    <h3 class="text-sm font-medium text-slate-500">Eier heute</h3>
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="9" ry="11" stroke-width="2"/><ellipse cx="12" cy="10" rx="3" ry="4" stroke-width="2"/></svg>
                </div>
                <div class="text-2xl font-bold tracking-tight text-slate-900">@todayEggs.ToString("N0")</div>
            </div>

            <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between pb-2">
                    <h3 class="text-sm font-medium text-slate-500">Ø Legeleistung</h3>
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <div class="text-2xl font-bold tracking-tight @(avgLay < 85 ? "text-amber-600" : "text-slate-900")">@avgLay.ToString("0.##")%</div>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200/50 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 px-6 py-4">
                <h3 class="text-base font-semibold text-slate-900">Futter- &amp; Wasserverbrauch</h3>
                <p class="text-sm text-slate-500">Letzte 7 Tage</p>
            </div>
            <div class="p-4 sm:p-6 h-[250px] sm:h-[300px]">
                <canvas id="consumptionChart"></canvas>
            </div>
        </div>

        <!-- Futterbestand-Verlauf Chart -->
        <div class="rounded-xl border border-slate-200/50 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 px-6 py-4 flex justify-between items-center">
                <div>
                    <h3 class="text-base font-semibold text-slate-900">📦 Futterbestand-Verlauf</h3>
                    <p class="text-sm text-slate-500">Letzte 30 Tage · Aktuell: <strong style="color:@GetBalanceColor()">@GetLastBalance().ToString("N0") kg</strong></p>
                </div>
                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors shadow-sm"
                        @onclick="() => OpenFeedDeliveryModal(0)">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                    Lieferung erfassen
                </button>
            </div>
            <div class="p-4 overflow-x-auto">
                @if (inventoryHistory.Count > 0)
                {
                    @((MarkupString)BuildInventoryChartSvg())
                }
                else
                {
                    <p class="text-sm text-slate-400 text-center py-10">Noch keine Daten – Lieferungen und freigegebene Einträge werden hier angezeigt.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="mb-6 flex items-center gap-4">
            <label class="text-sm font-medium text-slate-700">Stall wählen:</label>
            <select class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 shadow-sm focus:ring-2 focus:ring-blue-500/20 outline-none" @bind="detailStallId">
                <option value="0">Bitte wählen...</option>
                @foreach (var s in allStalls) { <option value="@s.Id">@s.Name</option> }
            </select>
        </div>

        @if (detailStallId > 0)
        {
            var ds = stallStats.FirstOrDefault(s => allStalls.Any(st => st.Id == detailStallId && st.Name == s.StallName));
            var dsStall = allStalls.FirstOrDefault(s => s.Id == detailStallId);
            var dsEntries = allHistoryEntries.Where(e => e.StallId == detailStallId).OrderByDescending(e => e.Date).ToList();
            var dsVerlustPct = ds != null && ds.Anfangsbestand > 0 ? (double)ds.Verluste / ds.Anfangsbestand * 100 : 0;
            var dsTodayEggs = dsEntries.Where(e => e.Date.Date == DateTime.Today).Sum(e => (e.Eier1Wahl ?? 0) + (e.Eier2Wahl ?? 0));
            
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                    <h3 class="text-sm font-medium text-slate-500 pb-2">Aktuell lebend</h3>
                    <div class="text-2xl font-bold text-slate-900">@(ds?.AktuellLebend.ToString("N0") ?? "0")</div>
                </div>
                <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                    <h3 class="text-sm font-medium text-slate-500 pb-2">Verluste</h3>
                    <div class="text-2xl font-bold @(dsVerlustPct > 1 ? "text-red-600" : "text-slate-900")">@(ds?.Verluste ?? 0) (@dsVerlustPct.ToString("0.##")%)</div>
                </div>
                <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                    <h3 class="text-sm font-medium text-slate-500 pb-2">Eier heute</h3>
                    <div class="text-2xl font-bold text-slate-900">@dsTodayEggs.ToString("N0")</div>
                </div>
                @if (dsStall != null) {
                    <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm">
                        <h3 class="text-sm font-medium text-slate-500 pb-2">Herdenalter</h3>
                        <div class="text-xl font-bold text-slate-700">@CalcService.GetFlockAge(dsStall.Einstallungsdatum, DateTime.Today)</div>
                    </div>
                }
                <div class="rounded-xl border border-slate-200/50 bg-white p-5 shadow-sm col-span-full lg:col-span-1">
                    <div class="flex items-center justify-between pb-2">
                        <h3 class="text-sm font-medium text-slate-500">Futterbestand</h3>
                        <button class="text-xs text-blue-600 hover:text-blue-800 font-medium" @onclick="() => OpenFeedDeliveryModal(detailStallId)">+ Lieferung</button>
                    </div>
                    <div class="flex items-center gap-3 mt-1">
                        @{
                            var balance = ds?.FeedBalanceKg ?? 0;
                            var colorClass = balance < 1000 ? "bg-red-500" : (balance < 3000 ? "bg-amber-400" : "bg-emerald-500");
                            var statusText = balance < 1000 ? "Kritisch" : (balance < 3000 ? "Knapp" : "Ausreichend");
                        }
                        <div class="h-4 w-4 rounded-full @colorClass shadow-sm border border-slate-200/50"></div>
                        <div class="text-2xl font-bold text-slate-900">@balance.ToString("N0") kg</div>
                    </div>
                    <div class="text-xs text-slate-50 mt-1">Status: @statusText</div>
                </div>
            </div>

        }
    }

    @if (pendingEntries.Any())
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 shadow-sm overflow-hidden">
            <div class="border-b border-amber-100 px-6 py-4 bg-amber-100/50 flex justify-between items-center">
                <h3 class="text-base font-semibold text-amber-900">Offene Freigaben (@pendingEntries.Count)</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-amber-100/30 text-amber-900 border-b border-amber-200">
                        <tr>
                            <th class="px-4 py-3 font-medium">Datum</th>
                            <th class="px-4 py-3 font-medium">Stall</th>
                            <th class="px-4 py-3 font-medium text-center">Verluste</th>
                            <th class="px-4 py-3 font-medium text-center">Zugänge</th>
                            <th class="px-4 py-3 font-medium text-center">Eier 1.W</th>
                            <th class="px-4 py-3 font-medium text-center">Eier 2.W</th>
                            <th class="px-4 py-3 font-medium text-center">Futter (kg)</th>
                            <th class="px-4 py-3 font-medium text-center">Wasser (L)</th>
                            <th class="px-4 py-3 font-medium">Aktion</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-amber-100">
                        @foreach (var entry in pendingEntries) {
                            <tr class="hover:bg-amber-100/20 transition-colors">
                                <td class="px-4 py-3 font-medium">
                                    @entry.Date.ToShortDateString()
                                    <span class="text-[10px] font-normal text-amber-700 block mt-0.5">Erfasst um @entry.CreatedAt.ToString("HH:mm") Uhr</span>
                                </td>
                                <td class="px-4 py-3">@entry.Stall?.Name</td>
                                <td class="px-4 py-3 text-center">
                                    @if (isAdmin) { <input type="number" class="w-16 rounded border-amber-200 px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-amber-500/20 text-center" @bind="entry.Verluste" placeholder="0" /> }
                                    else { <span>@entry.Verluste</span> }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (isAdmin) { <input type="number" class="w-16 rounded border-amber-200 px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-amber-500/20 text-center" @bind="entry.ZugaengeTiere" placeholder="0" /> }
                                    else { <span>@(entry.ZugaengeTiere ?? 0)</span> }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (isAdmin) { <input type="number" class="w-16 rounded border-amber-200 px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-amber-500/20 text-center" @bind="entry.Eier1Wahl" placeholder="0" /> }
                                    else { <span>@entry.Eier1Wahl</span> }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (isAdmin) { <input type="number" class="w-16 rounded border-amber-200 px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-amber-500/20 text-center" @bind="entry.Eier2Wahl" placeholder="0" /> }
                                    else { <span>@entry.Eier2Wahl</span> }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="flex flex-col items-center">
                                        @if (isAdmin) { <input type="number" step="0.1" class="w-20 rounded border-amber-200 px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-amber-500/20 text-center" @bind="entry.FutterKg" placeholder="0" /> }
                                        else { <span>@((entry.FutterKg ?? 0).ToString("N1"))</span> }
                                        @if (entry.FutterlieferungKg.HasValue)
                                        {
                                            <span class="text-[10px] text-blue-600 font-bold flex items-center gap-0.5 mt-0.5" title="Futterlieferung">
                                                🚚 @entry.FutterlieferungKg.Value.ToString("N0")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (isAdmin) { <input type="number" step="0.1" class="w-20 rounded border-amber-200 px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-amber-500/20 text-center" @bind="entry.WasserLiter" placeholder="0" /> }
                                    else { <span>@((entry.WasserLiter ?? 0).ToString("N1"))</span> }
                                </td>
                                <td class="px-4 py-3">
                                    @if (isAdmin)
                                    {
                                        bool isComplete = entry.Verluste.HasValue && entry.Eier1Wahl.HasValue && entry.FutterKg.HasValue && entry.WasserLiter.HasValue;
                                        <div class="flex items-center justify-center gap-1.5">
                                            <button class="p-1.5 rounded-md shadow-sm transition-all @(isComplete ? "bg-emerald-600 text-white hover:bg-emerald-700" : "bg-slate-300 text-slate-500 cursor-not-allowed")" 
                                                    disabled="@(!isComplete)"
                                                    @onclick="() => ApproveEntry(entry)" title="Freigeben">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            </button>
                                            <button class="p-1.5 rounded-md bg-red-600 text-white shadow-sm transition-all hover:bg-red-700" 
                                                    @onclick="() => RejectEntryAsync(entry)" title="Ablehnen">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                            </button>
                                            <button class="p-1.5 rounded-md bg-blue-600 text-white shadow-sm transition-all hover:bg-blue-700" 
                                                    @onclick="() => StartEdit(entry)" title="Bearbeiten">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="rounded-xl border border-slate-200/50 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
            <h3 class="text-base font-semibold text-slate-900">Historie (Freigegebene Einträge)</h3>
            @if (isAdmin)
            {
                <button class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700" @onclick="ExportLast7Days">Export (Excel)</button>
            }
        </div>
        
        <div class="p-4 bg-slate-50 border-b border-slate-100 flex flex-wrap gap-4 items-end">
            <select class="block rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700" @bind="filterStallId" @bind:after="ApplyFilter">
                <option value="0">Alle Ställe</option>
                @foreach (var s in allStalls) { <option value="@s.Id">@s.Name</option> }
            </select>
            <input type="date" class="block rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700" @bind="filterFrom" @bind:after="ApplyFilter" />
            <input type="date" class="block rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700" @bind="filterTo" @bind:after="ApplyFilter" />
            <button class="text-xs font-medium text-slate-500 hover:text-slate-900" @onclick="ResetFilter">Reset</button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 text-slate-500 border-b border-slate-200">
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider">Datum</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider">Stall</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider hidden md:table-cell">Erfasser</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider hidden lg:table-cell">Freigegeben</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-center">Alter</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-right">Verluste</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-right">Ges. Eier</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-right">Leistung</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-right hidden sm:table-cell">Futter/T</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-right">Futter</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-right">Wasser</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider hidden xl:table-cell">Bemerkung</th>
                        <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-center">Aktionen</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var entry in historyEntries)
                    {
                        var pastChangesH = allHistoryEntries.Where(e => e.StallId == entry.StallId && e.Date <= entry.Date).Sum(e => (e.Verluste ?? 0) - (e.ZugaengeTiere ?? 0));
                        var flockSizeH = entry.Stall != null ? entry.Stall.AnfangsbestandTiere - (pastChangesH - ((entry.Verluste ?? 0) - (entry.ZugaengeTiere ?? 0))) : 0; 
                        var currentFlockSize = flockSizeH - ((entry.Verluste ?? 0) - (entry.ZugaengeTiere ?? 0)); 
                        
                        var eggsH = (entry.Eier1Wahl ?? 0) + (entry.Eier2Wahl ?? 0);
                        var layH = CalcService.CalculateLayingPerformance(eggsH, flockSizeH);
                        var feedH = CalcService.CalculateFeedPerBird(entry.FutterKg ?? 0, flockSizeH);
                        var ageWeeks = entry.Stall != null ? 18 + (entry.Date - entry.Stall.Einstallungsdatum).Days / 7 : 18;
                        
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-3 py-3 font-medium text-slate-900 whitespace-nowrap">@entry.Date.ToShortDateString()</td>
                            <td class="px-3 py-3 text-slate-600 whitespace-nowrap font-semibold">@entry.Stall?.Name</td>
                            <td class="px-3 py-3 text-slate-500 text-xs hidden md:table-cell">@entry.Creator?.Username</td>
                            <td class="px-3 py-3 text-slate-500 text-xs hidden lg:table-cell">@entry.ApprovedBy?.Username</td>
                            <td class="px-3 py-3 text-center text-slate-600 tabular-nums">@ageWeeks</td>
                            <td class="px-3 py-3 text-right tabular-nums">
                                <div class="flex flex-col items-end">
                                     <span class="@((entry.Verluste ?? 0) > 0 ? "text-amber-600 font-medium" : "text-slate-400")">@(entry.Verluste ?? 0)</span>
                                     @if (entry.ZugaengeTiere > 0)
                                     {
                                         <span class="text-[10px] text-emerald-600 font-bold">+@entry.ZugaengeTiere</span>
                                     }
                                </div>
                            </td>
