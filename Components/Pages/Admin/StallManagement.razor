@page "/staelle"
@using LegelisteApp.Data
@using LegelisteApp.Data.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Stammtdaten: Ställe</PageTitle>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="flex h-16 items-center justify-between px-6">
        <div>
            <h1 class="text-lg font-semibold text-slate-900">Stall-Verwaltung</h1>
            <p class="text-sm text-slate-500">Stammdaten verwalten und neue Ställe anlegen</p>
        </div>
    </div>
</header>

<div class="grid gap-6 p-6 lg:grid-cols-12">
    @if (isLoading)
    {
        <div class="lg:col-span-12 flex h-[50vh] items-center justify-center">
            <div class="flex flex-col items-center gap-3">
                <div class="h-8 w-8 animate-spin rounded-full border-4 border-slate-200 border-t-blue-600"></div>
                <p class="text-sm font-medium text-slate-500">Daten werden geladen...</p>
            </div>
        </div>
    }
    else
    {
    <!-- Neuer Stall Formular -->
    <div class="lg:col-span-4">
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4">
                <h3 class="text-base font-semibold text-slate-900">Neuen Stall anlegen</h3>
            </div>
            <div class="p-6">
                <EditForm Model="newStall" OnValidSubmit="SaveStall">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-4">
                        <div class="space-y-1">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Stall Name</label>
                            <InputText @bind-Value="newStall.Name" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="z.B. Stall A" />
                            <ValidationMessage For="@(() => newStall.Name)" class="text-xs text-red-500 mt-1" />
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Anfangsbestand Tiere</label>
                            <InputNumber @bind-Value="newStall.AnfangsbestandTiere" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" />
                            <ValidationMessage For="@(() => newStall.AnfangsbestandTiere)" class="text-xs text-red-500 mt-1" />
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Einstallungsdatum</label>
                            <InputDate @bind-Value="newStall.Einstallungsdatum" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" />
                            <ValidationMessage For="@(() => newStall.Einstallungsdatum)" class="text-xs text-red-500 mt-1" />
                        </div>
                        
                        <button type="submit" class="w-full rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors">
                            Stall speichern
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- Stall Liste -->
    <div class="lg:col-span-8">
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 flex justify-between items-center">
                <h3 class="text-base font-semibold text-slate-900">Vorhandene Ställe</h3>
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">@stalls.Count Ställe</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="bg-slate-50/80 text-slate-500 border-b border-slate-200 uppercase text-[10px] font-bold tracking-wider">
                            <th class="px-6 py-3">ID</th>
                            <th class="px-6 py-3">Name</th>
                            <th class="px-6 py-3 text-right">Bestand</th>
                            <th class="px-6 py-3">Einstallung</th>
                            <th class="px-6 py-3 text-center">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var stall in stalls)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 font-mono text-slate-400">@stall.Id</td>
                                <td class="px-6 py-4 font-medium text-slate-900">@stall.Name</td>
                                <td class="px-6 py-4 text-right text-slate-600">@stall.AnfangsbestandTiere.ToString("N0")</td>
                                <td class="px-6 py-4 text-slate-600">@stall.Einstallungsdatum.ToShortDateString()</td>
                                <td class="px-6 py-4">
                                    <div class="flex justify-center gap-2">
                                        <button class="p-1.5 text-slate-400 hover:text-blue-600 transition-colors" @onclick="() => StartEdit(stall)">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </button>
                                        <button class="p-1.5 text-slate-400 hover:text-red-600 transition-colors" @onclick="() => AskDelete(stall.Id)">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (stalls.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-10 text-center text-slate-400 italic">Keine Ställe vorhanden.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    }
</div>

@if (editingStall != null)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="w-full max-w-lg rounded-xl bg-white shadow-2xl overflow-hidden border border-slate-200">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 class="text-lg font-bold text-slate-900">Stall bearbeiten</h3>
                <button @onclick="() => editingStall = null" class="text-slate-400 hover:text-slate-600">✕</button>
            </div>
            <div class="p-6 space-y-4">
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Name</label>
                    <input class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" @bind="editingStall.Name" />
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Anfangsbestand</label>
                    <input type="number" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" @bind="editingStall.AnfangsbestandTiere" />
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Einstallungsdatum</label>
                    <input type="date" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" @bind="editingStall.Einstallungsdatum" />
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                <button class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-slate-900" @onclick="() => editingStall = null">Abbrechen</button>
                <button class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm transition-colors" @onclick="SaveEdit">Speichern</button>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="w-full max-w-sm rounded-xl bg-white shadow-2xl p-6 text-center border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">Stall löschen?</h3>
            <p class="text-sm text-slate-500 mb-6">Möchten Sie diesen Stall wirklich permanent löschen? Alle zugehörigen Einträge gehen verloren.</p>
            <div class="flex gap-3">
                <button class="flex-1 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors" @onclick="() => showDeleteConfirm = false">Abbrechen</button>
                <button class="flex-1 px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 shadow-sm transition-colors" @onclick="ConfirmDelete">Löschen</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Stall> stalls = new();
    private Stall newStall = new() { Name = "", Einstallungsdatum = DateTime.Today };
    
    private Stall? editingStall = null;
    private bool showDeleteConfirm = false;
    private int deleteStallId = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadStallsAsync();
        isLoading = false;
    }

    private async Task LoadStallsAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        stalls = await context.Stalls.OrderBy(s => s.Name).ToListAsync();
    }

    private async Task SaveStall()
    {
        if (string.IsNullOrWhiteSpace(newStall.Name)) return;

        using var context = await DbFactory.CreateDbContextAsync();
        context.Stalls.Add(newStall);
        await context.SaveChangesAsync();

        newStall = new Stall { Name = "", Einstallungsdatum = DateTime.Today }; // Reset form
        await LoadStallsAsync(); // Refresh list
    }

    private void StartEdit(Stall stall)
    {
        editingStall = new Stall 
        { 
            Id = stall.Id, 
            Name = stall.Name, 
            AnfangsbestandTiere = stall.AnfangsbestandTiere,
            Einstallungsdatum = stall.Einstallungsdatum
        };
    }

    private async Task SaveEdit()
    {
        if (editingStall == null) return;
        using var context = await DbFactory.CreateDbContextAsync();
        var dbStall = await context.Stalls.FindAsync(editingStall.Id);
        if (dbStall != null)
        {
            dbStall.Name = editingStall.Name;
            dbStall.AnfangsbestandTiere = editingStall.AnfangsbestandTiere;
            dbStall.Einstallungsdatum = editingStall.Einstallungsdatum;
            await context.SaveChangesAsync();
        }
        editingStall = null;
        await LoadStallsAsync();
    }

    private void AskDelete(int id)
    {
        deleteStallId = id;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;
        using var context = await DbFactory.CreateDbContextAsync();
        var stall = await context.Stalls.FindAsync(deleteStallId);
        if (stall != null)
        {
            // Hinweis: In EF Core werden Einträge (DailyEntries) durch Cascade Delete gelöscht 
            // sofern die Beziehung so konfiguriert ist.
            context.Stalls.Remove(stall);
            await context.SaveChangesAsync();
        }
        await LoadStallsAsync();
    }
}
