@page "/benutzer"
@using LegelisteApp.Data
@using LegelisteApp.Data.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Stammtdaten: Benutzer</PageTitle>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="flex h-16 items-center justify-between px-6">
        <div>
            <h1 class="text-lg font-semibold text-slate-900">Benutzer-Verwaltung</h1>
            <p class="text-sm text-slate-500">Systembenutzer und Berechtigungen verwalten</p>
        </div>
    </div>
</header>

<div class="grid gap-6 p-6 lg:grid-cols-12">
    @if (isLoading)
    {
        <div class="lg:col-span-12 flex h-[50vh] items-center justify-center">
            <div class="flex flex-col items-center gap-3">
                <div class="h-8 w-8 animate-spin rounded-full border-4 border-slate-200 border-t-blue-600"></div>
                <p class="text-sm font-medium text-slate-500">Daten werden geladen...</p>
            </div>
        </div>
    }
    else
    {
    <!-- Neuer Benutzer Formular -->
    <div class="lg:col-span-4">
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4">
                <h3 class="text-base font-semibold text-slate-900">Neuen Benutzer anlegen</h3>
            </div>
            <div class="p-6">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 rounded-lg bg-red-50 p-3 text-xs font-medium text-red-800 border border-red-100">
                        @errorMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="mb-4 rounded-lg bg-emerald-50 p-3 text-xs font-medium text-emerald-800 border border-emerald-100">
                        @successMessage
                    </div>
                }

                <EditForm Model="newUser" OnSubmit="SaveUser">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-4">
                        <div class="space-y-1">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Benutzername</label>
                            <InputText @bind-Value="newUser.Username" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" />
                            <ValidationMessage For="@(() => newUser.Username)" class="text-xs text-red-500 mt-1" />
                        </div>

                        <div class="space-y-1">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Passwort</label>
                            <InputText @bind-Value="password" type="password" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" />
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Rolle</label>
                            <InputSelect @bind-Value="newUser.Role" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20">
                                @foreach (var role in Enum.GetValues<UserRole>())
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                        </div>
                        
                        <button type="submit" class="w-full rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors">
                            Benutzer anlegen
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- Benutzer Liste -->
    <div class="lg:col-span-8">
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 flex justify-between items-center">
                <h3 class="text-base font-semibold text-slate-900">Vorhandene Benutzer</h3>
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">@users.Count Benutzer</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="bg-slate-50/80 text-slate-500 border-b border-slate-200 uppercase text-[10px] font-bold tracking-wider">
                            <th class="px-6 py-3">ID</th>
                            <th class="px-6 py-3">Benutzername</th>
                            <th class="px-6 py-3">Rolle</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3 text-right">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var user in users)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 font-mono text-slate-400">@user.Id</td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-500 uppercase">
                                            @user.Username.Substring(0, 1)
                                        </div>
                                        <span class="font-medium text-slate-900">@user.Username</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @(user.Role == UserRole.Admin ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @(user.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700")">
                                        @(user.IsActive ? "Aktiv" : "Inaktiv")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (!user.Username.Equals("admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button class="text-blue-500 hover:text-blue-700 p-1 transition-colors mr-2" @onclick="() => OpenEditModal(user)" title="Bearbeiten">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                        </button>
                                        <button class="text-red-500 hover:text-red-700 p-1 transition-colors" @onclick="() => DeleteUser(user)" title="Löschen">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    }
</div>

@if (editingUser != null)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="w-full max-w-sm rounded-xl bg-white shadow-2xl overflow-hidden border border-slate-200">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 class="text-base font-bold text-slate-900">Benutzer bearbeiten</h3>
                <button @onclick="() => editingUser = null" class="p-1 text-slate-400 hover:text-slate-600 transition-colors">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Benutzername</label>
                    <div class="font-medium text-slate-900">@editingUser.Username</div>
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Status</label>
                    <div class="flex items-center gap-2 mt-2">
                        <input type="checkbox" id="isActiveCheck" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind="editIsActive" />
                        <label for="isActiveCheck" class="text-sm font-medium text-slate-700">Benutzer ist aktiv</label>
                    </div>
                </div>
                
                <div class="space-y-1 pt-4 border-t border-slate-100">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Passwort ändern (optional)</label>
                    <input type="password" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500/20" @bind="editPassword" placeholder="Neues Passwort..." />
                    <p class="text-xs text-slate-400 mt-1">Leer lassen, um das aktuelle Passwort zu behalten.</p>
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                <button class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" @onclick="() => editingUser = null">Abbrechen</button>
                <button class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 shadow-sm transition-colors" @onclick="SaveEditedUser">Speichern</button>
            </div>
        </div>
    </div>
}

@code {
    private List<User> users = new();
    private User newUser = new() { Username = "", PasswordHash = "" };
    private string password = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = true;

    private User? editingUser;
    private string editPassword = "";
    private bool editIsActive = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadUsersAsync();
        isLoading = false;
    }

    private async Task LoadUsersAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        users = await context.Users.OrderBy(u => u.Username).ToListAsync();
    }

    private async Task SaveUser()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(newUser.Username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Benutzername und Passwort sind erforderlich.";
            return;
        }

        using var context = await DbFactory.CreateDbContextAsync();
        
        var exists = await context.Users.AnyAsync(u => u.Username == newUser.Username);
        if (exists)
        {
            errorMessage = "Ein Benutzer mit diesem Namen existiert bereits.";
            return;
        }

        var passwordHasher = new PasswordHasher<User>();
        newUser.PasswordHash = passwordHasher.HashPassword(newUser, password);

        context.Users.Add(newUser);
        await context.SaveChangesAsync();

        successMessage = $"Benutzer '{newUser.Username}' wurde erfolgreich angelegt.";

        // Reset form
        newUser = new User { Username = "", PasswordHash = "" }; 
        password = "";
        
        await LoadUsersAsync(); // Refresh list
    }

    private async Task DeleteUser(User user)
    {
        if (user.Username.Equals("admin", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Fehler: Der Administrator-Account ('admin') darf nicht gelöscht werden!";
            successMessage = "";
            return;
        }

        using var context = await DbFactory.CreateDbContextAsync();
        var dbUser = await context.Users.FindAsync(user.Id);
        if (dbUser != null)
        {
            context.Users.Remove(dbUser);
            await context.SaveChangesAsync();
            successMessage = $"Benutzer '{user.Username}' wurde gelöscht.";
            errorMessage = "";
            await LoadUsersAsync();
        }
    }

    private void OpenEditModal(User user)
    {
        editingUser = user;
        editIsActive = user.IsActive;
        editPassword = "";
        errorMessage = "";
        successMessage = "";
    }

    private async Task SaveEditedUser()
    {
        if (editingUser == null) return;
        
        using var context = await DbFactory.CreateDbContextAsync();
        var dbUser = await context.Users.FindAsync(editingUser.Id);
        
        if (dbUser != null)
        {
            dbUser.IsActive = editIsActive;
            
            if (!string.IsNullOrWhiteSpace(editPassword))
            {
                var passwordHasher = new PasswordHasher<User>();
                dbUser.PasswordHash = passwordHasher.HashPassword(dbUser, editPassword);
            }
            
            await context.SaveChangesAsync();
            successMessage = $"Benutzer '{dbUser.Username}' wurde erfolgreich aktualisiert.";
            errorMessage = "";
            
            editingUser = null;
            await LoadUsersAsync();
        }
    }
}
